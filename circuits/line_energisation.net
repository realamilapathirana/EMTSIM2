# Energising a 100 km, 230 kV line: travelling waves and switching overvoltage
#
#   GRID -- BRK1 -- LINE1 (Bergeron, open end)                    no protection
#        -- BRK2 -- LINE2 (Bergeron, open end) + surge arresters  with protection
#
# Both breakers close at 20 ms, at the voltage peak of phase a (worst case). The wave
# travels to the open end in 0.34 ms (aerial modes), doubles there, and keeps bouncing.
# Compare the open-end voltages of LINE1 and LINE2 (LINE1's open end is reported as
# "not connected" in the editor: that is the open circuit).
#
# Elements used: V3 behind sequence impedance, SW, TL3 (Bergeron, with losses), MOV.
#
# Generated by circuits/make_drawings.py; open it in the circuit editor (gui.bat) to see the drawing.
#
# EMTSim netlist: line energisation (drawn with the EMTSim circuit editor)
#
# Format: R/L/C from to value | V from to peak angle freq [R] | SW from to closed|open times... | F from to t_apply [t_clear]
# 15 nodes (5 three-phase nodes), 12 elements
# Three-phase drawing: node k of the drawing is netlist node 3k-2 (phase a), 3k-1 (b) and 3k (c)

.tran 0.000005 0.04

V3 1 2 3  187794 0 50  0.5 0.04 1 0.08   # GRID
SW 1 4  open 0.02   # BRK1.a
SW 2 5  open 0.02   # BRK1.b
SW 3 6  open 0.02   # BRK1.c
TL3 4 5 6 10 11 12  300 0.000345 600 0.00045 3 20   # LINE1
SW 1 7  open 0.02   # BRK2.a
SW 2 8  open 0.02   # BRK2.b
SW 3 9  open 0.02   # BRK2.c
TL3 7 8 9 13 14 15  300 0.000345 600 0.00045 3 20   # LINE2
MOV 13 0  300000 1000 26   # ARR.a
MOV 14 0  300000 1000 26   # ARR.b
MOV 15 0  300000 1000 26   # ARR.c

#@layout {"v":1,"components":[{"type":"V3","name":"GRID","x":-4,"y":8,"rot":0,"params":{"mag":"187794","angle":"0","freq":"50","r":"0.5","l1":"0.04","r0":"1.0","l0":"0.08"}},{"type":"GND","name":"GND","x":-4,"y":8,"rot":0,"params":{}},{"type":"SW3","name":"BRK1","x":8,"y":8,"rot":0,"params":{"mode":"together","state":"open","times":"0.02","opens":"at the time"}},{"type":"TL3","name":"LINE1","x":14,"y":8,"rot":0,"params":{"z1":"300","tau1":"0.345m","z0":"600","tau0":"0.45m","r1":"3","r0":"20"}},{"type":"SW3","name":"BRK2","x":8,"y":18,"rot":0,"params":{"mode":"together","state":"open","times":"0.02","opens":"at the time"}},{"type":"TL3","name":"LINE2","x":14,"y":18,"rot":0,"params":{"z1":"300","tau1":"0.345m","z0":"600","tau0":"0.45m","r1":"3","r0":"20"}},{"type":"MOV3","name":"ARR","x":20,"y":18,"rot":90,"params":{"vref":"300000","iref":"1000","q":"26"}},{"type":"GND","name":"GND","x":20,"y":22,"rot":0,"params":{}}],"wires":[{"x1":0,"y1":8,"x2":8,"y2":8},{"x1":12,"y1":8,"x2":14,"y2":8},{"x1":6,"y1":8,"x2":6,"y2":18},{"x1":6,"y1":18,"x2":8,"y2":18},{"x1":12,"y1":18,"x2":14,"y2":18},{"x1":18,"y1":18,"x2":20,"y2":18}],"phases":3,"settings":{"dt":"5u","tstop":"40m"}}
