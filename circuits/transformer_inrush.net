# Transformer inrush: energising an unloaded 11/0.4 kV transformer at voltage zero
#
# The core flux starts from zero, so energising at a voltage zero drives the flux to almost
# twice its rated peak; beyond the knee (1.15 pu) the core saturates and the magnetising
# current rises to many times its normal value, decaying over many cycles.
# T_SAT has a saturating core (two-slope curve), T_LIN the same transformer with a linear core.
#
# Elements used: V behind R + L, SW, XF (single-phase transformer, with and without saturation).
#
# Generated by circuits/make_drawings.py; open it in the circuit editor (gui.bat) to see the drawing.
#
# EMTSim netlist: transformer inrush (drawn with the EMTSim circuit editor)
#
# Format: R/L/C from to value | V from to peak angle freq [R] | SW from to closed|open times... | F from to t_apply [t_clear]
# 5 nodes, 7 elements

.tran 0.00005 0.2

V 0 1  8981.6 0 50 0.5 0.01   # GRID
SW 1 2  open 0.005   # BRK_SAT
XF 2 0 4 0  1000000 6351 231 50 0.06 0.01 im=1 knee=1.15 lsat=0.15   # T_SAT
R 4 0  10000   # OPEN_SAT
SW 1 3  open 0.005   # BRK_LIN
XF 3 0 5 0  1000000 6351 231 50 0.06 0.01 im=1   # T_LIN
R 5 0  10000   # OPEN_LIN

#@layout {"v":1,"components":[{"type":"V","name":"GRID","x":-4,"y":8,"rot":0,"params":{"mag":"8981.6","angle":"0","freq":"50","r":"0.5","l":"0.01"}},{"type":"GND","name":"GND","x":-4,"y":8,"rot":0,"params":{}},{"type":"SW","name":"BRK_SAT","x":8,"y":8,"rot":0,"params":{"state":"open","times":"0.005","opens":"at the time"}},{"type":"XF","name":"T_SAT","x":13,"y":8,"rot":0,"params":{"S":"1M","v1":"6351","v2":"231","freq":"50","x":"0.06","r":"0.01","im":"1","knee":"1.15","lsat":"0.15"}},{"type":"R","name":"OPEN_SAT","x":17,"y":8,"rot":90,"params":{"value":"1e4"}},{"type":"GND","name":"GND","x":17,"y":12,"rot":0,"params":{}},{"type":"SW","name":"BRK_LIN","x":8,"y":18,"rot":0,"params":{"state":"open","times":"0.005","opens":"at the time"}},{"type":"XF","name":"T_LIN","x":13,"y":18,"rot":0,"params":{"S":"1M","v1":"6351","v2":"231","freq":"50","x":"0.06","r":"0.01","im":"1","knee":"","lsat":""}},{"type":"R","name":"OPEN_LIN","x":17,"y":18,"rot":90,"params":{"value":"1e4"}},{"type":"GND","name":"GND","x":17,"y":22,"rot":0,"params":{}}],"wires":[{"x1":0,"y1":8,"x2":8,"y2":8},{"x1":12,"y1":8,"x2":13,"y2":8},{"x1":6,"y1":8,"x2":6,"y2":18},{"x1":6,"y1":18,"x2":8,"y2":18},{"x1":12,"y1":18,"x2":13,"y2":18}],"settings":{"dt":"50u","tstop":"200m"}}
