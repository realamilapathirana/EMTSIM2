# Generator and motor: induction motor start and a fault near a synchronous generator
#
#   GEN (synchronous, 20 MVA, 11 kV) -- bus 1 -- LINE (coupled R-L) -- bus 2 -- GRID (11 kV, impedance)
#                                                                      bus 2 -- MOTOR (induction, 2 MVA)
#
# Events
#   0 s     the induction motor starts direct on line from standstill (load torque ~ speed^2)
#   1.0 s   three-phase fault at bus 1 (next to the generator)
#   1.15 s  fault cleared: the generator rotor swings and settles
# Recorded: GEN.speed[pu], GEN.delta[deg], GEN.Pe[pu], MOTOR.speed[pu], MOTOR.torque[pu].
# The generator starts at its equilibrium rotor angle for 0.8 pu: delta0 = asin(Pm X / E) = 37 deg,
# with X = xd'' + line + grid = 0.2 + 0.52 + 0.10 pu on 20 MVA.
#
# Elements used: SM, IM, RL3, V3 behind impedance, F3.
#
# Generated by circuits/make_drawings.py; open it in the circuit editor (gui.bat) to see the drawing.
#
# EMTSim netlist: generator and motor (drawn with the EMTSim circuit editor)
#
# Format: R/L/C from to value | V from to peak angle freq [R] | SW from to closed|open times... | F from to t_apply [t_clear]
# 6 nodes (2 three-phase nodes), 7 elements
# Three-phase drawing: node k of the drawing is netlist node 3k-2 (phase a), 3k-1 (b) and 3k (c)

.tran 0.0001 2

SM 1 2 3  20000000 11000 50 3 0.2 0.003 1.1 37 0.8 d=2   # GEN
F 1 0  1 1.15   # FAULT.a
F 2 0  1 1.15   # FAULT.b
F 3 0  1 1.15   # FAULT.c
RL3 1 2 3 4 5 6  0.05 0.01 0.15 0.03   # LINE
V3 4 5 6  8981.6 0 50  0.02 0.002 0.05 0.005   # GRID
IM 4 5 6  2000000 11000 50 4 0.01 0.1 0.04 0.1 3 0.3 0.6 speed0=0   # MOTOR

#@layout {"v":1,"components":[{"type":"SM","name":"GEN","x":2,"y":8,"rot":0,"params":{"S":"20M","v":"11k","freq":"50","H":"3","xd2":"0.2","ra":"0.003","E":"1.1","delta0":"37","Pm":"0.8","d":"2"}},{"type":"F3","name":"FAULT","x":10,"y":8,"rot":0,"params":{"kind":"abc-g","mode":"together","t_apply":"1.0","t_clear":"1.15"}},{"type":"RL3","name":"LINE","x":16,"y":8,"rot":0,"params":{"r1":"0.05","l1":"0.01","r0":"0.15","l0":"0.03"}},{"type":"V3","name":"GRID","x":22,"y":12,"rot":270,"params":{"mag":"8981.6","angle":"0","freq":"50","r":"0.02","l1":"0.002","r0":"0.05","l0":"0.005"}},{"type":"GND","name":"GND","x":22,"y":12,"rot":0,"params":{}},{"type":"IM","name":"MOTOR","x":36,"y":8,"rot":0,"params":{"S":"2M","v":"11k","freq":"50","poles":"4","rs":"0.01","xls":"0.1","rr":"0.04","xlr":"0.1","xm":"3","H":"0.3","Tload":"0.6","speed0":"0"}}],"wires":[{"x1":2,"y1":8,"x2":16,"y2":8},{"x1":20,"y1":8,"x2":36,"y2":8}],"phases":3,"settings":{"dt":"100u","tstop":"2"}}
