# Tiny book of EMT simulation, chapter 6: the network of chapter 5 with a fault at node 3
# from 30 ms to 60 ms.
# The book works through the plain trapezoidal rule (chapter 8 shows its chatter), so
# chatter removal and switching interpolation are off here.
.options chatter=off interp=off
.tran 0.00005 0.08
V 0 1  100 0 50    # SOURCE
R 1 2  1           # R1
L 2 3  0.01        # L
C 3 0  10e-6       # C
R 3 0  100         # LOAD
F 3 0  0.03 0.06   # FAULT
